diff --git a/tests/test_replay_env_config.py b/tests/test_replay_env_config.py
new file mode 100644
index 0000000..4670115
--- /dev/null
+++ b/tests/test_replay_env_config.py
@@ -0,0 +1,125 @@
+from functools import partial
+
+import pytest
+
+from robolab.core.replay import env_config
+
+
+def _predicate(*, env=None, object=None):
+    return env is not None and object is not None
+
+
+class _Subtask:
+    def __init__(self):
+        self.conditions = {"banana": [(partial(_predicate, object="banana"), 1.0)]}
+
+
+class _EnvCfg:
+    def __init__(self):
+        self.instruction = {"default": "Live instruction"}
+        self._instruction_variants = {"default": "Live instruction"}
+
+
+def test_callable_container_is_preserved() -> None:
+    live = {"subtasks": [_Subtask()]}
+    recorded = {
+        "subtasks": [
+            {
+                "conditions": {
+                    "banana": [
+                        [
+                            "functools.partial(<function _predicate at 0x1>, object='banana')",
+                            1.0,
+                        ]
+                    ]
+                }
+            }
+        ]
+    }
+
+    skipped = env_config.apply_recorded_env_cfg(live, recorded)
+
+    assert callable(live["subtasks"][0].conditions["banana"][0][0])
+    assert any(
+        item.startswith("[EXPECTED_RUNTIME_PRESERVATION]") and "/subtasks[0]/conditions/banana" in item
+        for item in skipped
+    )
+
+
+def test_missing_condition_key_does_not_inject_recorded_code() -> None:
+    live = {"subtasks": [_Subtask()]}
+    recorded = {
+        "subtasks": [
+            {
+                "conditions": {
+                    "orange": [["example.module.predicate", 1.0]],
+                }
+            }
+        ]
+    }
+
+    skipped = env_config.apply_recorded_env_cfg(live, recorded)
+
+    assert "orange" not in live["subtasks"][0].conditions
+    assert any(item.startswith("[SCHEMA_DRIFT]") and "/subtasks[0]/conditions/orange" in item for item in skipped)
+
+
+def test_existing_callable_identity_is_preserved(monkeypatch) -> None:
+    live = {"terminations": {"success": {"func": _predicate}}}
+    recorded = {"terminations": {"success": {"func": "tests.predicate"}}}
+    monkeypatch.setattr(env_config, "string_to_callable", lambda _: _predicate)
+
+    skipped = env_config.apply_recorded_env_cfg(live, recorded)
+
+    assert live["terminations"]["success"]["func"] is _predicate
+    assert skipped == []
+
+
+def test_unimportable_callable_fails_closed(monkeypatch) -> None:
+    live = {"terminations": {"success": {"func": _predicate}}}
+    recorded = {"terminations": {"success": {"func": "missing.predicate"}}}
+
+    def _raise(_):
+        raise ImportError("not importable")
+
+    monkeypatch.setattr(env_config, "string_to_callable", _raise)
+    skipped = env_config.apply_recorded_env_cfg(live, recorded)
+
+    assert live["terminations"]["success"]["func"] is _predicate
+    assert len(skipped) == 1
+    assert skipped[0].startswith("[INVALID_RECORDED_VALUE]")
+
+
+def test_recorded_only_plain_data_requires_explicit_namespace() -> None:
+    live = {"events": {"probe": {"params": {}}}, "other": {}}
+    recorded = {
+        "events": {"probe": {"params": {"threshold": 3}}},
+        "other": {"new_key": 3},
+    }
+
+    skipped = env_config.apply_recorded_env_cfg(live, recorded)
+
+    assert live["events"]["probe"]["params"]["threshold"] == 3
+    assert "new_key" not in live["other"]
+    assert any(item.startswith("[SCHEMA_DRIFT] /other/new_key") for item in skipped)
+
+
+@pytest.mark.parametrize("has_live_metadata", [False, True])
+def test_instruction_variants_are_runtime_owned(has_live_metadata: bool) -> None:
+    live = _EnvCfg()
+    if not has_live_metadata:
+        del live._instruction_variants
+    recorded = {
+        "_instruction_variants": {"default": "Recorded lossy metadata"},
+        "instruction": "Recorded resolved instruction",
+    }
+
+    skipped = env_config.apply_recorded_env_cfg(live, recorded)
+
+    assert live.instruction == "Recorded resolved instruction"
+    if has_live_metadata:
+        assert live._instruction_variants == {"default": "Live instruction"}
+    else:
+        assert not hasattr(live, "_instruction_variants")
+    assert len(skipped) == 1
+    assert skipped[0].startswith("[EXPECTED_RUNTIME_PRESERVATION] /_instruction_variants")
