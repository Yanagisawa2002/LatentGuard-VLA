 import json
 import os
 import re
+from collections.abc import Mapping
+from functools import partial
 
 from isaaclab.utils.string import string_to_callable
 
@@ -42,6 +44,31 @@ _RUNTIME_KEY_NAMESPACES = {
     "/scene/env_spacing",
 }
 
+_EXPECTED_RUNTIME_PRESERVATION = "EXPECTED_RUNTIME_PRESERVATION"
+_SCHEMA_DRIFT = "SCHEMA_DRIFT"
+_INVALID_RECORDED_VALUE = "INVALID_RECORDED_VALUE"
+
+# These values are created or owned by the live task/runtime. JSON is only a
+# lossy record of them, so replay reports and preserves them instead of using
+# the recording as code.
+_RUNTIME_METADATA_NAMESPACES = {
+    "/_instruction_variants",
+}
+
+# Missing keys are accepted only in explicit declarative-data namespaces.
+# Runtime code containers are never reconstructed from JSON strings.
+_RUNTIME_CODE_NAMESPACE_PATTERNS = (
+    re.compile(r"^/subtasks\[\d+\]/conditions(?:/.*)?$"),
+    re.compile(r"^/(?:actions|events|observations|rewards|terminations)(?:/.*)?/func$"),
+)
+_RECORDED_ONLY_DATA_NAMESPACE_PATTERNS = (
+    re.compile(r"^/sim/render/carb_settings(?:/.*)?$"),
+    re.compile(
+        r"^/(?:actions|events|observations|rewards|terminations)"
+        r"(?:/.*)?/params(?:/.*)?$"
+    ),
+)
+
 
 def load_recorded_env_cfg(hdf5_path: str) -> tuple[dict, str] | None:
     """Load the ``env_cfg.json`` sidecar recorded next to an HDF5 episode file.
@@ -106,21 +133,123 @@ def _assign(obj, key: str, value) -> None:
         setattr(obj, key, value)
 
 
+def _classified_skip(skipped: list[str], category: str, key_ns: str, reason: str) -> None:
+    skipped.append(f"[{category}] {key_ns} ({reason})")
+
+
+def _matches_namespace(key_ns: str, patterns: tuple[re.Pattern, ...]) -> bool:
+    return any(pattern.fullmatch(key_ns) is not None for pattern in patterns)
+
+
+def _contains_callable(value, seen: set[int] | None = None) -> bool:
+    """Return whether a live container contains runtime callable code."""
+    if callable(value):
+        return True
+    if not isinstance(value, (Mapping, list, tuple)):
+        return False
+    if seen is None:
+        seen = set()
+    identity = id(value)
+    if identity in seen:
+        return False
+    seen.add(identity)
+    if isinstance(value, Mapping):
+        return any(_contains_callable(item, seen) for item in value.values())
+    return any(_contains_callable(item, seen) for item in value)
+
+
+def _callable_identity(value) -> tuple:
+    """Build a stable identity for an importable function or partial."""
+    if isinstance(value, partial):
+        return (
+            "partial",
+            _callable_identity(value.func),
+            value.args,
+            tuple(sorted((value.keywords or {}).items())),
+        )
+    return (
+        "callable",
+        getattr(value, "__module__", None),
+        getattr(value, "__qualname__", getattr(value, "__name__", None)),
+    )
+
+
+def _preserve_callable_target(
+    target,
+    recorded,
+    key_ns: str,
+    skipped: list[str],
+) -> None:
+    if not isinstance(recorded, str):
+        _classified_skip(
+            skipped,
+            _INVALID_RECORDED_VALUE,
+            key_ns,
+            f"live value is callable but recorded value is {type(recorded).__name__}",
+        )
+        return
+    try:
+        resolved = string_to_callable(recorded)
+    except Exception:
+        _classified_skip(
+            skipped,
+            _INVALID_RECORDED_VALUE,
+            key_ns,
+            f"callable '{recorded}' not safely importable",
+        )
+        return
+    if _callable_identity(resolved) != _callable_identity(target):
+        _classified_skip(
+            skipped,
+            _SCHEMA_DRIFT,
+            key_ns,
+            "recorded callable identity differs from live callable",
+        )
+    # Identity matches: keep the live object. Recorded config restores data,
+    # while the current source tree supplies executable code.
+
+
 def _overlay(obj, data: dict, ns: str, skipped: list[str]) -> None:
     """Recursively write recorded values onto ``obj``, collecting mismatches in ``skipped``."""
     for key, value in data.items():
         key_ns = f"{ns}/{key}"
         if key_ns in _RUNTIME_KEY_NAMESPACES:
             continue
+        if key_ns in _RUNTIME_METADATA_NAMESPACES:
+            _classified_skip(
+                skipped,
+                _EXPECTED_RUNTIME_PRESERVATION,
+                key_ns,
+                "live runtime metadata is not restored from JSON",
+            )
+            continue
         if isinstance(obj, dict):
             if key not in obj:
-                # Plain dicts (event params, carb settings) accept recorded-only keys.
-                obj[key] = value
+                if _matches_namespace(
+                    key_ns,
+                    _RECORDED_ONLY_DATA_NAMESPACE_PATTERNS,
+                ):
+                    obj[key] = value
+                else:
+                    reason = (
+                        "recorded-only runtime code key was not injected"
+                        if _matches_namespace(
+                            key_ns,
+                            _RUNTIME_CODE_NAMESPACE_PATTERNS,
+                        )
+                        else "recorded-only key is outside declarative-data allowlist"
+                    )
+                    _classified_skip(skipped, _SCHEMA_DRIFT, key_ns, reason)
                 continue
             target = obj[key]
         else:
             if not hasattr(obj, key):
-                skipped.append(f"{key_ns} (not in current config)")
+                _classified_skip(
+                    skipped,
+                    _SCHEMA_DRIFT,
+                    key_ns,
+                    "not in current config",
+                )
                 continue
             target = getattr(obj, key)
 
@@ -131,21 +260,43 @@ def _overlay(obj, data: dict, ns: str, skipped: list[str]) -> None:
             _assign(obj, key, value)
             continue
 
+        if callable(target):
+            _preserve_callable_target(target, value, key_ns, skipped)
+            continue
+
         if isinstance(value, dict):
             if isinstance(target, dict) or hasattr(target, "__dict__"):
                 _overlay(target, value, key_ns, skipped)
             else:
-                skipped.append(f"{key_ns} (recorded a config group, current value is {type(target).__name__})")
+                _classified_skip(
+                    skipped,
+                    _SCHEMA_DRIFT,
+                    key_ns,
+                    f"recorded a config group, current value is {type(target).__name__}",
+                )
             continue
 
         if isinstance(value, list):
+            if isinstance(target, (list, tuple)) and _contains_callable(target):
+                _classified_skip(
+                    skipped,
+                    _EXPECTED_RUNTIME_PRESERVATION,
+                    key_ns,
+                    "live container includes callable runtime code",
+                )
+                continue
             if any(isinstance(element, dict) for element in value):
                 if isinstance(target, (list, tuple)) and len(target) == len(value):
                     for i, element in enumerate(value):
                         if isinstance(element, dict):
                             _overlay(target[i], element, f"{key_ns}[{i}]", skipped)
                 else:
-                    skipped.append(f"{key_ns} (nested list shape changed)")
+                    _classified_skip(
+                        skipped,
+                        _SCHEMA_DRIFT,
+                        key_ns,
+                        "nested list shape changed",
+                    )
                 continue
             _assign(obj, key, tuple(value) if isinstance(target, tuple) else value)
             continue
@@ -155,13 +306,12 @@ def _overlay(obj, data: dict, ns: str, skipped: list[str]) -> None:
                 try:
                     _assign(obj, key, _string_to_slice(value))
                 except ValueError:
-                    skipped.append(f"{key_ns} (unparsable slice string)")
-                continue
-            if target is not None and callable(target):
-                try:
-                    _assign(obj, key, string_to_callable(value))
-                except Exception:
-                    skipped.append(f"{key_ns} (callable '{value}' not importable)")
+                    _classified_skip(
+                        skipped,
+                        _INVALID_RECORDED_VALUE,
+                        key_ns,
+                        "unparsable slice string",
+                    )
                 continue
             _assign_scalar(obj, key, _reroot_asset_path(value), target, key_ns, skipped)
             continue
@@ -179,4 +329,9 @@ def _assign_scalar(obj, key: str, value, target, key_ns: str, skipped: list[str]
     if is_compatible:
         _assign(obj, key, value)
     else:
-        skipped.append(f"{key_ns} (type mismatch: current {type(target).__name__}, recorded {type(value).__name__})")
+        _classified_skip(
+            skipped,
+            _SCHEMA_DRIFT,
+            key_ns,
+            f"type mismatch: current {type(target).__name__}, recorded {type(value).__name__}",
