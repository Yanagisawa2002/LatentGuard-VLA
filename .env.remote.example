# Copy to an ignored local file and replace every placeholder locally.
# Prefer an SSH host alias configured outside this repository.
LATENTGUARD_REMOTE_HOST=example-training-host
LATENTGUARD_REMOTE_REPO=/example/latentguard-vla
LATENTGUARD_REMOTE_RUN_ROOT=/example/runs/latentguard-vla
LATENTGUARD_REMOTE_PYTHON=python3
LATENTGUARD_REMOTE_ENV_COMMAND=

# These optional values mirror remote-sync CLI flags.
LATENTGUARD_REMOTE_BRANCH=codex/milestone-name
LATENTGUARD_REMOTE_COMMIT=0000000000000000000000000000000000000000
LATENTGUARD_REMOTE_SSH_EXECUTABLE=ssh
LATENTGUARD_REMOTE_CONNECT_TIMEOUT=15
